aws_region   = "ap-south-1"
project_name = "terraform-aws-devops"
environment  = "dev"

vpc_cidr = "10.0.0.0/16"

subnets = {
  public_1 = {
    cidr_block        = "10.0.1.0/24"
    availability_zone = "ap-south-1a"
    name              = "dev-public-subnet-1"
  }

  public_2 = {
    cidr_block        = "10.0.2.0/24"
    availability_zone = "ap-south-1b"
    name              = "dev-public-subnet-2"
  }
}

alb_security_group_name = "dev-alb-security-group"
ec2_security_group_name = "dev-ec2-security-group"

alb_ingress_rules = {
  http = {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

ec2_ingress_rules = {
  ssh = {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["203.0.113.10/32"]
  }
}

egress_rules = {
  all_traffic = {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

instance_type = "t3.micro"